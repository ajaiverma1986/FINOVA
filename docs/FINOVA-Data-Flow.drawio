<mxCell id="title" value="FINOVA - Detailed Data Flow: React, Security, Audit and Logging" style="whiteSpace=wrap;html=0;fontSize=14;spacing=12;strokeWidth=2;text;fontStyle=1;fontSize=24;" vertex="1" parent="1"><mxGeometry x="40" y="15" width="1720" height="50" as="geometry"/></mxCell>
<mxCell id="react" value="React Frontend&#xa;Login credentials / business requests&#xa;Receives usertoken / JSON results / errors" style="whiteSpace=wrap;html=0;fontSize=14;spacing=12;strokeWidth=2;rounded=0;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="690" y="90" width="360" height="110" as="geometry"/></mxCell>
<mxCell id="middleware" value="1. Request middleware (Program.cs)&#xa;Extract apitoken / usertoken from headers&#xa;Query-string fallback; resolve caller context" style="whiteSpace=wrap;html=0;fontSize=14;spacing=12;strokeWidth=2;rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="690" y="270" width="360" height="110" as="geometry"/></mxCell>
<mxCell id="cache" value="In-process memory cache&#xa;Application / user identity / permissions&#xa;Cache miss: AuthenticationProvider -> Repository" style="whiteSpace=wrap;html=0;fontSize=14;spacing=12;strokeWidth=2;shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=18;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1180" y="270" width="450" height="110" as="geometry"/></mxCell>
<mxCell id="authentication" value="2. Authentication / token validation&#xa;AuthenticationHelper -> AuthenticationProvider&#xa;Verify API token and user token via SQL&#xa;Login credentials: see Authentication page" style="whiteSpace=wrap;html=0;fontSize=14;spacing=12;strokeWidth=2;rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="150" y="460" width="400" height="130" as="geometry"/></mxCell>
<mxCell id="authorization" value="3. Authorization (conditional)&#xa;AuthorizationHelper compares requested PermissionID&#xa;against cached user/application permissions&#xa;Runs only when accessType != Permissions.NONE" style="whiteSpace=wrap;html=0;fontSize=14;spacing=12;strokeWidth=2;rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="690" y="460" width="360" height="140" as="geometry"/></mxCell>
<mxCell id="token" value="Token management&#xa;Generate + persist usertoken on login&#xa;Verify / sliding-expiration flag&#xa;ExpireUserToken operation exists in provider/repository&#xa;See Token and Authorization page" style="whiteSpace=wrap;html=0;fontSize=14;spacing=12;strokeWidth=2;rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1180" y="455" width="450" height="160" as="geometry"/></mxCell>
<mxCell id="api" value="4. FINOVA.API Controllers&#xa;Bind DTO / multipart data; invoke checks&#xa;Return business results or error payload" style="whiteSpace=wrap;html=0;fontSize=14;spacing=12;strokeWidth=2;rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="690" y="690" width="360" height="110" as="geometry"/></mxCell>
<mxCell id="service" value="5. FINOVA.Provider&#xa;Validation + business processing&#xa;Users / orgs / wallet / transactions / reports" style="whiteSpace=wrap;html=0;fontSize=14;spacing=12;strokeWidth=2;rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="690" y="870" width="360" height="110" as="geometry"/></mxCell>
<mxCell id="repository" value="6. FINOVA.Repository + FINOVA.Database&#xa;SQL parameters / stored procedures / ADO.NET&#xa;Map returned records / output values" style="whiteSpace=wrap;html=0;fontSize=14;spacing=12;strokeWidth=2;rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="690" y="1050" width="360" height="110" as="geometry"/></mxCell>
