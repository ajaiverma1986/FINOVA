<mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="title" value="FINOVA - Token Management and Authorization Data Flow" style="whiteSpace=wrap;html=0;fontSize=14;spacing=12;strokeWidth=2;text;fontStyle=1;fontSize=24;" vertex="1" parent="1"><mxGeometry x="40" y="15" width="1720" height="50" as="geometry"/></mxCell>
<mxCell id="react" value="React Frontend&#xa;Protected API request&#xa;apitoken + usertoken headers" style="whiteSpace=wrap;html=0;fontSize=14;spacing=12;strokeWidth=2;rounded=0;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="80" y="130" width="330" height="120" as="geometry"/></mxCell>
<mxCell id="context" value="1. Resolve caller context (middleware)&#xa;Cache lookup; on miss query&#xa;AAC.usp_GetApplicationAndUserDetails&#xa;Populate IFINOVAServiceUser" style="whiteSpace=wrap;html=0;fontSize=14;spacing=12;strokeWidth=2;rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="560" y="120" width="480" height="140" as="geometry"/></mxCell>
<mxCell id="cache" value="Memory cache&#xa;Application/user details + user IDs&#xa;USER_ROLES_API(applicationId, usertoken)&#xa;Permission records" style="whiteSpace=wrap;html=0;fontSize=14;spacing=12;strokeWidth=2;shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=18;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1190" y="120" width="480" height="140" as="geometry"/></mxCell>
<mxCell id="verify" value="2. Verify tokens (endpoint helper)&#xa;AuthenticationHelper.AuthenticateAndAuthorize&#xa;AuthenticationProvider.IsValidToken&#xa;Defaults: validateBothToken=true&#xa;slidingExpiration=true" style="whiteSpace=wrap;html=0;fontSize=14;spacing=12;strokeWidth=2;rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="560" y="360" width="480" height="160" as="geometry"/></mxCell>
<mxCell id="sql" value="AuthenticationRepository -> SQL Server&#xa;AAC.usp_VerifyUserToken&#xa;apitoken / usertoken / validateBothToken /&#xa;slidingExpiration -> Boolean result" style="whiteSpace=wrap;html=0;fontSize=14;spacing=12;strokeWidth=2;shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=18;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1190" y="365" width="480" height="150" as="geometry"/></mxCell>
<mxCell id="permissions" value="3. Load permissions (middleware/provider)&#xa;Cache miss: AAC.usp_GetUserAccessPermissions&#xa;UserMasterID + ApplicationID&#xa;Cache RoleID / PermissionID records" style="whiteSpace=wrap;html=0;fontSize=14;spacing=12;strokeWidth=2;rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="80" y="610" width="360" height="160" as="geometry"/></mxCell>
<mxCell id="authorize" value="4. AuthorizationHelper.Authorize&#xa;accessType == NONE: no permission lookup&#xa;Otherwise match requested PermissionID&#xa;Missing list or no match -> AUTHORIZATION_FAILURE" style="whiteSpace=wrap;html=0;fontSize=14;spacing=12;strokeWidth=2;rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="560" y="630" width="480" height="150" as="geometry"/></mxCell>
<mxCell id="clear" value="Invalid / missing token branch&#xa;Clear cache using raw API/user token keys&#xa;Authentication failure setting is commented out" style="whiteSpace=wrap;html=0;fontSize=14;spacing=12;strokeWidth=2;rounded=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1190" y="630" width="480" height="150" as="geometry"/></mxCell>
<mxCell id="controller" value="5. Controller / business operation&#xa;Checks ErrorResponse.HasError&#xa;Error -> response payload&#xa;Otherwise -> provider / repository / database" style="whiteSpace=wrap;html=0;fontSize=14;spacing=12;strokeWidth=2;rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="560" y="910" width="480" height="140" as="geometry"/></mxCell>
<mxCell id="logout" value="Token expiration support (provider/repository)&#xa;AuthenticationProvider.Logout&#xa;AAC.usp_ExpireUserToken(usertoken)&#xa;No logout controller endpoint found" style="whiteSpace=wrap;html=0;fontSize=14;spacing=12;strokeWidth=2;rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="80" y="910" width="360" height="150" as="geometry"/></mxCell>
<mxCell id="expiry" value="SQL Server token lifecycle&#xa;Create: AAC.usp_CreateUserToken&#xa;Verify: AAC.usp_VerifyUserToken&#xa;Expire: AAC.usp_ExpireUserToken&#xa;Expiry / extension rules are in stored procedures" style="whiteSpace=wrap;html=0;fontSize=14;spacing=12;strokeWidth=2;shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=18;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1190" y="910" width="480" height="160" as="geometry"/></mxCell>
<mxCell id="flow0" value="Tokens + request metadata" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;strokeWidth=1.5;" edge="1" parent="1" source="react" target="context"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="flow1" value="Context/permission cache lookup" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;strokeWidth=1.5;exitX=1;exitY=0.25;entryX=0;entryY=0.25;" edge="1" parent="1" source="context" target="cache"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="flow2" value="Cached context / identity" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;strokeWidth=1.5;exitX=0;exitY=0.75;entryX=1;entryY=0.75;" edge="1" parent="1" source="cache" target="context"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="flow3" value="Caller context + tokens" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;strokeWidth=1.5;" edge="1" parent="1" source="context" target="verify"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="flow4" value="Token validation parameters" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;strokeWidth=1.5;exitX=1;exitY=0.25;entryX=0;entryY=0.25;" edge="1" parent="1" source="verify" target="sql"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="flow5" value="Validation Boolean" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;strokeWidth=1.5;exitX=0;exitY=0.75;entryX=1;entryY=0.75;" edge="1" parent="1" source="sql" target="verify"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="flow6" value="Invalid/missing tokens" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;strokeWidth=1.5;" edge="1" parent="1" source="verify" target="clear"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="flow7" value="Token-check ErrorResponse" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;strokeWidth=1.5;" edge="1" parent="1" source="verify" target="authorize"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="flow8" value="User/application identity on permission cache miss" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;strokeWidth=1.5;" edge="1" parent="1" source="context" target="permissions"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="flow9" value="Permission records to cache" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;strokeWidth=1.5;exitX=0.5;exitY=0;entryX=0.5;entryY=0;" edge="1" parent="1" source="permissions" target="cache"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="260" y="80"/><mxPoint x="1430" y="80"/></Array></mxGeometry></mxCell>
<mxCell id="flow10" value="Cached access records when permission required" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;strokeWidth=1.5;" edge="1" parent="1" source="cache" target="authorize"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="flow11" value="Authorization success / failure" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;strokeWidth=1.5;" edge="1" parent="1" source="authorize" target="controller"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="flow12" value="Current ErrorResponse may still have no error" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;strokeWidth=1.5;" edge="1" parent="1" source="clear" target="controller"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="flow13" value="Business result / authorization error" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;strokeWidth=1.5;exitX=0;exitY=0.75;entryX=0;entryY=0.75;" edge="1" parent="1" source="controller" target="react"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="40" y="1015"/><mxPoint x="40" y="220"/></Array></mxGeometry></mxCell>
<mxCell id="flow14" value="Usertoken expiration request (internal support)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;strokeWidth=1.5;dashed=1;exitX=0.5;exitY=1;entryX=0.5;entryY=1;" edge="1" parent="1" source="logout" target="expiry"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="260" y="1170"/><mxPoint x="1430" y="1170"/></Array></mxGeometry></mxCell>
<mxCell id="flow15" value="Token lookup / lifecycle updates" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;strokeWidth=1.5;" edge="1" parent="1" source="sql" target="expiry"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="notes" value="Solid arrows show data transfers. Dashed expiration arrow denotes provider/repository support without an exposed logout endpoint found in the inspected controllers.&#xa;Authorization runs only for non-NONE accessType. Cached permission records are populated by middleware/provider; AuthorizationHelper itself does not reload missing permissions.&#xa;Invalid-token cache clearing uses raw token keys while identity/permission caching uses formatted keys. No refresh-token endpoint or specific expiry duration was found." style="whiteSpace=wrap;html=0;fontSize=14;spacing=12;strokeWidth=2;rounded=0;fillColor=#f5f5f5;strokeColor=#666666;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="1250" width="1720" height="150" as="geometry"/></mxCell>
</root>
</mxGraphModel>
</diagram>
<diagram id="audit" name="Audit and Logging">
<mxGraphModel dx="1600" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1510" math="0" shadow="0">
<root>
<mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="title" value="FINOVA - Audit and Application Logging Data Flow" style="whiteSpace=wrap;html=0;fontSize=14;spacing=12;strokeWidth=2;text;fontStyle=1;fontSize=24;" vertex="1" parent="1"><mxGeometry x="40" y="15" width="1720" height="50" as="geometry"/></mxCell>
<mxCell id="action" value="Audited action: POST /AA/Login&#xa;[AuditApi] on AAController.Login&#xa;Request headers included&#xa;Response body included&#xa;Request body / model state excluded" style="whiteSpace=wrap;html=0;fontSize=14;spacing=12;strokeWidth=2;rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="90" y="120" width="660" height="170" as="geometry"/></mxCell>
<mxCell id="error" value="Controller action exception&#xa;FINOVExceptionFilterService&#xa;Collect URL / IP / referrer / headers + tokens&#xa;Build SERVER_ERROR response (HTTP 500)" style="whiteSpace=wrap;html=0;fontSize=14;spacing=12;strokeWidth=2;rounded=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1010" y="120" width="660" height="170" as="geometry"/></mxCell>
<mxCell id="capture" value="Audit.WebApi / Audit.NET&#xa;Capture action audit event&#xa;Include request/response action metadata" style="whiteSpace=wrap;html=0;fontSize=14;spacing=12;strokeWidth=2;rounded=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="90" y="380" width="660" height="120" as="geometry"/></mxCell>
<mxCell id="logging" value="FINOVA.Logging.LoggingService&#xa;LogError -> message / stack / inner exception&#xa;LogMessage (Info) / LogWarning (Warn) when invoked&#xa;Caller / application metadata -> NLog properties" style="whiteSpace=wrap;html=0;fontSize=14;spacing=12;strokeWidth=2;rounded=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1010" y="380" width="660" height="150" as="geometry"/></mxCell>
<mxCell id="mask" value="OnEventSaving action (Program.cs)&#xa;If ActionParameters contains userLoginRequest:&#xa;Password = ***NOT-LOGGED***" style="whiteSpace=wrap;html=0;fontSize=14;spacing=12;strokeWidth=2;rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="90" y="610" width="660" height="120" as="geometry"/></mxCell>
<mxCell id="nlog" value="NLog configuration: nlog.config&#xa;Logger NLOG; minlevel Info; target db&#xa;Structured parameters incl. apitoken / usertoken /&#xa;headers / URL / IP / stack / message&#xa;Connection overridden by LoggingDB setting" style="whiteSpace=wrap;html=0;fontSize=14;spacing=12;strokeWidth=2;rounded=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1010" y="610" width="660" height="160" as="geometry"/></mxCell>
<mxCell id="auditdb" value="SQL Server - FIADB&#xa;Audit.SqlServer SqlDataProvider&#xa;Schema dbo / table Event&#xa;EventId / Data (JSON) / LastUpdatedDate" style="whiteSpace=wrap;html=0;fontSize=14;spacing=12;strokeWidth=2;shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=18;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="90" y="880" width="660" height="160" as="geometry"/></mxCell>
<mxCell id="logdb" value="SQL Server - LoggingDB&#xa;Database target via System.Data.SqlClient&#xa;Stored procedure dbo.usp_Log_add&#xa;Structured Info / Warn / Error records" style="whiteSpace=wrap;html=0;fontSize=14;spacing=12;strokeWidth=2;shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=18;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1010" y="880" width="660" height="160" as="geometry"/></mxCell>
<mxCell id="internal" value="NLog internal diagnostics&#xa;internalLogLevel=Warn&#xa;File: admin_logging_error.txt&#xa;NLog configuration / target failures" style="whiteSpace=wrap;html=0;fontSize=14;spacing=12;strokeWidth=2;shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=18;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1010" y="1160" width="660" height="110" as="geometry"/></mxCell>
<mxCell id="client" value="React Frontend&#xa;Login response for audited action&#xa;HTTP 500 + SERVER_ERROR on handled exception" style="whiteSpace=wrap;html=0;fontSize=14;spacing=12;strokeWidth=2;rounded=0;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="90" y="1160" width="660" height="110" as="geometry"/></mxCell>
<mxCell id="flow0" value="Login action / request / response data" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;strokeWidth=1.5;" edge="1" parent="1" source="action" target="capture"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="flow1" value="AuditEventWebApi + action parameters" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;strokeWidth=1.5;" edge="1" parent="1" source="capture" target="mask"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="flow2" value="Serialized event JSON" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;strokeWidth=1.5;" edge="1" parent="1" source="mask" target="auditdb"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="flow3" value="Exception + Log metadata" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;strokeWidth=1.5;" edge="1" parent="1" source="error" target="logging"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="flow4" value="NLog.LogEventInfo (level + properties)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;strokeWidth=1.5;" edge="1" parent="1" source="logging" target="nlog"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="flow5" value="Execute dbo.usp_Log_add" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;strokeWidth=1.5;" edge="1" parent="1" source="nlog" target="logdb"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="flow6" value="Internal diagnostic messages" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;strokeWidth=1.5;exitX=1;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="nlog" target="internal"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1720" y="690"/><mxPoint x="1720" y="1215"/></Array></mxGeometry></mxCell>
<mxCell id="flow7" value="HTTP 500 error payload" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;strokeWidth=1.5;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="error" target="client"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="880" y="205"/><mxPoint x="880" y="1215"/></Array></mxGeometry></mxCell>
<mxCell id="flow8" value="Login result" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;strokeWidth=1.5;exitX=0;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="action" target="client"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="40" y="205"/><mxPoint x="40" y="1215"/></Array></mxGeometry></mxCell>
<mxCell id="notes" value="Audit coverage found is the Login action; configuring the SQL provider does not audit every endpoint automatically. Audit records and NLog application logs are separate flows.&#xa;The password mask applies to the named login action parameter; it is not general token/header redaction. Login audit includes headers and response body; NLog also records token/header properties.&#xa;NLog internal diagnostics go to admin_logging_error.txt, separately from the SQL log target. Info/Warn logs require explicit calls; exception logging is wired through the controller exception filter." style="whiteSpace=wrap;html=0;fontSize=14;spacing=12;strokeWidth=2;rounded=0;fillColor=#f5f5f5;strokeColor=#666666;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="1320" width="1720" height="150" as="geometry"/></mxCell>
</root>
</mxGraphModel>
</diagram>
</mxfile>
