<mxfile host="app.diagrams.net"><diagram id="process" name="Application Process Flow"><mxGraphModel grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1600" pageHeight="2040" arrows="1" connect="1"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="start" value="User opens React application" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;spacing=8;" vertex="1" parent="1"><mxGeometry x="560" y="50" width="380" height="65" as="geometry"/></mxCell><mxCell id="login" value="Submit login credentials + API token" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;spacing=8;" vertex="1" parent="1"><mxGeometry x="560" y="170" width="380" height="80" as="geometry"/></mxCell><mxCell id="credentials" value="API checks user status,&#xa;BCrypt password + application access" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;spacing=8;" vertex="1" parent="1"><mxGeometry x="560" y="300" width="380" height="90" as="geometry"/></mxCell><mxCell id="valid" value="Login successful?" style="rhombus;whiteSpace=wrap;html=0;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;spacing=8;" vertex="1" parent="1"><mxGeometry x="600" y="440" width="300" height="100" as="geometry"/></mxCell><mxCell id="loginerror" value="Return login error&#xa;React stays on login screen" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;spacing=8;" vertex="1" parent="1"><mxGeometry x="1110" y="440" width="360" height="100" as="geometry"/></mxCell><mxCell id="token" value="Generate custom user token&#xa;Persist token in SQL Server" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;spacing=8;" vertex="1" parent="1"><mxGeometry x="560" y="590" width="380" height="85" as="geometry"/></mxCell><mxCell id="frontend" value="React retains session (proposed)&#xa;User selects a business action" style="rounded=1;