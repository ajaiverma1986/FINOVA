rap;html=0;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;spacing=8;" vertex="1" parent="1"><mxGeometry x="560" y="1330" width="380" height="100" as="geometry"/></mxCell><mxCell id="repo" value="Repository + ADO.NET&#xa;Execute SQL Server SP / SQL&#xa;Files stored where endpoint requires" style="shape=cylinder3;size=15;whiteSpace=wrap;html=0;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;spacing=8;" vertex="1" parent="1"><mxGeometry x="560" y="1490" width="380" height="100" as="geometry"/></mxCell><mxCell id="response" value="Return Result / Errors&#xa;React checks HTTP status + HasError" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;spacing=8;" vertex="1" parent="1"><mxGeometry x="560" y="1650" width="380" height="90" as="geometry"/></mxCell><mxCell id="finish" value="React displays outcome&#xa;Refresh affected records on success" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;spacing=8;" vertex="1" parent="1"><mxGeometry x="560" y="1800" width="380" height="85" as="geometry"/></mxCell><mxCell id="audit" value="Audit: annotated login action&#xa;Audit.NET -> dbo.Event&#xa;Password action parameter masked" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;spacing=8;" vertex="1" parent="1"><mxGeometry x="65" y="300" width="360" height="110" as="geometry"/></mxCell><mxCell id="logging" value="Action exception -> exception filter&#xa;NLog -> logging SQL database&#xa;HTTP 500 + SERVER_ERROR" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;spacing=8;" vertex="1" parent="1"><mxGeometry x="65" y="1490" width="360" height="120" as="geometry"/></mxCell><mxCell id="note" value="Current implementation:&#xa;Missing/invalid-token handling clears cache&#xa;but authentication-error setting is commented out.&#xa;SQL token lifetime is unverified.&#xa;Logout exists internally; no endpoint found." style="rounded=1